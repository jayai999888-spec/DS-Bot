{
  "expo": {
    "name": "Jubala Bot",
    "slug": "dsbot",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.jayai999888.jubalabot",
      "infoPlist": {
        "CFBundleLocalizations": ["en", "zh-Hans"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF1DC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.github.jayai999888.jubalabot",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "scheme": "dsbot",
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Jubala Bot uses the camera to scan the pairing code that your computer shows.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/android-release-signing.js",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "extraProguardRules": "-keep class com.google.mlkit.** { *; }\n-keep class com.google.android.gms.internal.mlkit_vision_barcode.** { *; }\n-keep class com.google.android.gms.internal.mlkit_vision_common.** { *; }\n-keep class com.google.android.odml.** { *; }"
          }
        }
      ]
    ]
  }
}
